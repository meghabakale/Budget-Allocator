# ============================================================
# Environment variables required to run BudgetFlow locally.
# Copy this file to .env and fill in the values.
# On Replit these are configured as Secrets (never commit real values).
# ============================================================

# ---- API Server (artifacts/api-server) ----

# MongoDB connection string (required)
# Local:   mongodb://127.0.0.1:27017/budgetflow
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/budgetflow
MONGODB_URI=mongodb://127.0.0.1:27017/budgetflow

# Secret used to sign JWT tokens — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# Session secret (declared but not currently active; reserve for future use)
SESSION_SECRET=change_me_to_another_long_random_secret

# Port for the API server (managed automatically by Replit workflows)
PORT=8080

# ---- Budget App frontend (artifacts/budget-app) ----

# Port for the Vite dev server (managed automatically by Replit workflows)
# PORT=24432

# URL base-path prefix (managed automatically by Replit workflows)
# BASE_PATH=/
